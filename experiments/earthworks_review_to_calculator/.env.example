TELEGRAM_BOT_TOKEN=put_your_token_here

# Optional Telegram-only proxy. Supported schemes: http, socks5h.
# TELEGRAM_PROXY_SCHEME=http
# TELEGRAM_PROXY_HOST=proxy.example
# TELEGRAM_PROXY_PORT=8080
# TELEGRAM_PROXY_USERNAME=proxy_user
# TELEGRAM_PROXY_PASSWORD=proxy_password

# Optional: restrict bot to specific Telegram chat IDs (comma-separated)
# If not set, all users can access the bot (not recommended in production)
# TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
